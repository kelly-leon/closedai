# Deployment mode: selfhosted or hosted
MODE=selfhosted
TRIAL_MESSAGES=20
TRIAL_DOCUMENTS=3
ADMIN_API_KEY=

# Authentication provider
AUTH_PROVIDER=none

# File storage provider
STORAGE_PROVIDER=local

# Embedding provider
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-2
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# File ingestion
UPLOAD_DIR=./uploads
SUPABASE_BUCKET=documents
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# PostgreSQL connection (the pgvector image is used by Docker Compose)
DATABASE_URL=postgresql+psycopg://closedai:closedai@localhost:5432/closedai

# LLM provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
TOP_K=6
SIMILARITY_THRESHOLD=0.2
MAX_TOOL_ROUNDS=6
CHAT_HISTORY_LIMIT=20

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=none
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_AUTH=false
NEXT_PUBLIC_UPGRADE_TEXT=Pay via M-Pesa to 07xx and send the receipt on WhatsApp.

# Comma-separated origins allowed by the backend
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Hosted mode: Supabase configuration (ignored by selfhosted mode)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=

# Hosted mode: optional Stripe billing configuration
# These variables are not imported or used in selfhosted mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
